# Copia a .env. Nunca subas valores reales.
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL core (ledger) y analytics (proyecciones)
CORE_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/core
ANALYTICS_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/analytics

# LocalStack (SQS/S3)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/events.fifo
RECEIPTS_BUCKET=receipts-local

# Auth0 (tenant de desarrollo)
AUTH0_DOMAIN=your-dev-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.family-expense.local
